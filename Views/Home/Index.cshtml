@* ══════════════════════════════════════════════════════════════════════════
   FAQ
   ══════════════════════════════════════════════════════════════════════════ *@
@if (Model.Faqs.Count > 0)
{
    <section class="sv-section sv-section--alt">
        <div class="sv-container sv-container--narrow">
            @await Html.PartialAsync("_SectionHeading", Sec("faq"))
            <div class="sv-acc sv-reveal">
                @foreach (var faq in Model.Faqs)
                {
                    <div class="sv-acc__item">
                        <button class="sv-acc__head" type="button" aria-expanded="false">
                            <span>@Lang.Pick(faq.QuestionAr, faq.QuestionEn)</span>
                            <i class="fa-solid fa-plus"></i>
                        </button>
                        <div class="sv-acc__body">
                            <div class="sv-rte">@Html.Raw(Lang.Pick(faq.AnswerAr, faq.AnswerEn))</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@* ══════════════════════════════════════════════════════════════════════════
   CTA
   ══════════════════════════════════════════════════════════════════════════ *@
@{ var cta = Sec("cta"); }
@if (cta is not null)
{
    <section class="sv-cta">
        <div class="sv-container">
            <div class="sv-cta__inner sv-reveal">
                <div>
                    @if (!string.IsNullOrWhiteSpace(Lang.Pick(cta.EyebrowAr, cta.EyebrowEn)))
                    {
                        <span class="sv-eyebrow">@Lang.Pick(cta.EyebrowAr, cta.EyebrowEn)</span>
                    }
                    <h2>@Lang.Pick(cta.TitleAr, cta.TitleEn)</h2>
                    @if (!string.IsNullOrWhiteSpace(Lang.Pick(cta.SubtitleAr, cta.SubtitleEn)))
                    {
                        <p>@Lang.Pick(cta.SubtitleAr, cta.SubtitleEn)</p>
                    }
                </div>
                <div class="sv-cta__actions">
                    @if (!string.IsNullOrWhiteSpace(Lang.Pick(cta.ButtonTextAr, cta.ButtonTextEn)))
                    {
                        <a class="sv-btn sv-btn--light sv-btn--lg" href="@(cta.ButtonUrl ?? Lang.Url("/quote"))">
                            @Lang.Pick(cta.ButtonTextAr, cta.ButtonTextEn) <i class="fa-solid @arrow"></i>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Lang.Pick(cta.Button2TextAr, cta.Button2TextEn)))
                    {
                        <a class="sv-btn sv-btn--on-dark sv-btn--lg" href="@(cta.Button2Url ?? Lang.Url("/contact"))">
                            @Lang.Pick(cta.Button2TextAr, cta.Button2TextEn)
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>
}
